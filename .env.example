# Copy to .env next to docker-compose.yml. Everything is optional.

# Docker image to run.
NESTFUND_IMAGE=eazyeight/nestfund:latest

# Host port mapped to the app (the container listens on 7777).
NESTFUND_PORT=7777

# Timezone used for "today" (recurring transactions, default dates).
TZ=Europe/Lisbon

# Optional passphrase used to encrypt stored API keys (Trading 212). If unset, a random key is
# generated in the data volume (secret.key). Changing it later means re-entering the API key.
NESTFUND_SECRET=

# Optional HTTP Basic Auth. Leave empty when the app is protected by Cloudflare Access.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
