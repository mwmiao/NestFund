# Copy to .env and adjust. All variables are optional.

# Docker image to run (your Docker Hub username / repository).
NESTFUND_IMAGE=mwmiao/nestfund:latest

# Host port mapped to the container's port 777.
NESTFUND_PORT=777

# Timezone used for "today" (recurring transactions, default dates).
TZ=Europe/Lisbon

# Load the realistic sample data on the first run (set to false for an empty start).
SEED_SAMPLE_DATA=true

# Optional HTTP Basic Auth. Leave empty when protecting the app with Cloudflare Access.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
